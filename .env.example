# Copy this file to .env and fill in your Supabase project's values.
# Find both in the Supabase Dashboard: Project Settings -> API.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the public "anon" / "publishable" key — safe to
# ship in a browser bundle. NEVER put the service_role / secret key here or in any
# VITE_ variable: anything prefixed VITE_ is bundled into the client-side JS and
# visible to anyone who opens the app.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
